{
  "dashboard": {
    "title": "Stellar-K8s Per-Node Statistics",
    "description": "Detailed per-node metrics for Stellar Core instances and operator replicas",
    "tags": ["stellar", "kubernetes", "per-node", "detailed"],
    "timezone": "browser",
    "refresh": "30s",
    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(stellar_core_ledger_sequence, instance)",
          "multi": true,
          "allValue": ".*"
        }
      ]
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Node Sync Status",
        "type": "table",
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "stellar_core_is_synced",
            "format": "table",
            "instant": true
          }
        ]
      },
      {
        "id": 2,
        "title": "Ledger Sequence Per Node",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
        "targets": [
          {
            "expr": "stellar_core_ledger_sequence{instance=~\"$instance\"}",
            "legendFormat": "{{ instance }}"
          }
        ],
        "yaxes": [
          {
            "label": "Sequence Number",
            "format": "short"
          }
        ]
      },
      {
        "id": 3,
        "title": "Memory Usage Per Node (MB)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
        "targets": [
          {
            "expr": "stellar:core:node:memory:usage{instance=~\"$instance\"}",
            "legendFormat": "{{ instance }}"
          }
        ],
        "yaxes": [
          {
            "label": "MB",
            "format": "short"
          }
        ]
      },
      {
        "id": 4,
        "title": "CPU Usage Per Node (%)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
        "targets": [
          {
            "expr": "stellar:core:node:cpu:usage_percent{instance=~\"$instance\"}",
            "legendFormat": "{{ instance }}"
          }
        ],
        "yaxes": [
          {
            "label": "Percentage",
            "format": "percent",
            "min": 0,
            "max": 100
          }
        ]
      },
      {
        "id": 5,
        "title": "Network Connections Per Node",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
        "targets": [
          {
            "expr": "stellar:core:node:connections:incoming{instance=~\"$instance\"}",
            "legendFormat": "{{ instance }} (incoming)"
          },
          {
            "expr": "stellar:core:node:connections:outgoing{instance=~\"$instance\"}",
            "legendFormat": "{{ instance }} (outgoing)"
          }
        ],
        "yaxes": [
          {
            "label": "Connections",
            "format": "short"
          }
        ]
      },
      {
        "id": 6,
        "title": "Work Queue Depth Per Node",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
        "targets": [
          {
            "expr": "stellar:core:node:queue_depth{instance=~\"$instance\"}",
            "legendFormat": "{{ instance }}"
          }
        ],
        "yaxes": [
          {
            "label": "Bytes",
            "format": "bytes"
          }
        ]
      },
      {
        "id": 7,
        "title": "Quorum Status Per Node",
        "type": "table",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 22},
        "targets": [
          {
            "expr": "stellar_core_quorum_intact",
            "format": "table",
            "instant": true
          }
        ]
      },
      {
        "id": 8,
        "title": "Ledger Close Time Distribution",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "rate(stellar_core_ledger_close_time_bucket[5m])",
            "format": "heatmap"
          }
        ]
      }
    ]
  }
}
