{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Container image repository"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "description": "Image pull policy"
        },
        "tag": {
          "type": "string",
          "description": "Image tag (defaults to chart appVersion)"
        }
        ,
        "digest": {
          "type": "string",
          "description": "Optional image digest (sha256:...) to pin exact image"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "secrets": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "autoscaling": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "arch": {
      "type": "string"
    },
    "podDisruptionBudget": {
      "type": "object"
    },
    "operator": {
      "type": "object",
      "properties": {
        "logLevel": {
          "type": "string",
          "enum": ["trace", "debug", "info", "warn", "error"]
        },
        "restApiEnabled": {
          "type": "boolean"
        },
        "restApiPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "watchNamespace": {
          "type": "string"
        },
        "profiling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "sidecar": {
      "type": "object"
    },
    "forkDetector": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "restApiPort": {
          "type": "integer"
        },
        "metricsPort": {
          "type": "integer"
        }
      }
    },
    "defaultResources": {
      "type": "object"
    },
    "featureFlags": {
      "type": "object"
    },
    "security": {
      "type": "object"
    },
    "networkIsolation": {
      "type": "object"
    },
    "byzantineWatcher": {
      "type": "object"
    },
    "otel": {
      "type": "object"
    },
    "logShipper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "When true, render the per-node Fluent Bit log shipper DaemonSet"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "kubernetesFilter": {
          "type": "boolean"
        },
        "jsonParsing": {
          "type": "boolean"
        },
        "logLevel": {
          "type": "string",
          "enum": ["info", "warn", "error", "debug"]
        },
        "resources": {
          "type": "object"
        },
        "loki": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "tenantId": {
              "type": "string"
            }
          }
        },
        "elasticsearch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "index": {
              "type": "string"
            }
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "scpAnalytics": {
      "type": "object"
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "When true, render admission webhook resources"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of webhook server replicas"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Container port for the webhook HTTPS server"
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Container port for the Prometheus metrics endpoint"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "description": "Admission review timeout in seconds (Kubernetes maximum is 30)"
        },
        "failurePolicy": {
          "type": "string",
          "enum": ["Fail", "Ignore"],
          "description": "Action when webhook is unreachable: Fail blocks admission, Ignore allows it"
        },
        "resources": {
          "type": "object",
          "description": "Resource requests and limits for the webhook server container"
        },
        "certManager": {
          "type": "object",
          "description": "Optional cert-manager Certificate/ClusterIssuer rendering for webhook TLS",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "When true, render cert-manager Certificate and ClusterIssuer resources"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
