# Generated by Cargo
# will have compiled files and executables
debug/
target/
**/target/

# Stray checked-in generated artifact
stellar-k8s

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Rust coverage and profiling artifacts
coverage/
tarpaulin-report.html
cobertura.xml
lcov.info
*.profraw
*.profdata
criterion/

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Stellar Wave Artifacts
.github/WAVE_ISSUES.md

# Development configs (may contain secrets)
config/dev/*.kubeconfig
config/dev/*-secret.yaml
.kube/
kubeconfig
kubeconfig-*
*.kubeconfig
kind-*.yaml

# AI Agent & Planning Artifacts
.claude/
.agents/
.cursor/
.gemini/
.windsurf/
task_plan.md
findings.md
progress.md
issue-*-requirement.md
requirements.md
CI_CD_REVIEW.md

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

issue.md
COMMIT_MESSAGE_TEMPLATE.md
# Python bytecode cache
__pycache__/
*.pyc

# Orphaned NPM lock file (no package.json at root)
package-lock.json

# AI agent tooling
.antigravitycli/

# Generated Logs & Reports
*.log
*_log.txt
log.txt
build_errors.txt
check_output.txt
*_COMPLETE.md
*_report.md
rendered-output.yaml

# Temporary Test Files
test_*.rs
starfield.html
skills-lock.json

# Benchmark results — regenerate with: make benchmark-webhook-save
# Keep results/.gitkeep tracked so the directory exists for local/CI writes.
results/*
!results/.gitkeep

# Scratch Helm render from `make bundle-render` (repo root only; deleted by
# `make bundle-validate`). Anchored so it cannot swallow the committed drift
# goldens under charts/stellar-operator/rendered/ (issue #1045).
/rendered/
rendered-manifests.yaml

# Committed Helm drift goldens — regenerate with: make helm-drift-update
!charts/stellar-operator/rendered/

# OLM bundle — fully generated (metadata + manifests) from config/manifests/bases by operator-sdk, regenerate with: make bundle
bundle/

# Generated shell completions and Helm dependency/package artifacts
completions/
charts/**/charts/
charts/**/Chart.lock
charts/**/*.tgz

# Local toolchain downloads
.tools/

